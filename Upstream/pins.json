{
  "$comment": "What qeetrix-ios is built from: three npm packages, each fetched by Scripts/sync-upstream.sh from the registry, checked against the registry's integrity hash, and recorded in upstream.lock.json with the sha256 of every file taken from it. Edit a pin, then run the sync; nothing else in Upstream/ is edited by hand. Paths are relative to the repository root, or to the package tarball (package/...).",
  "tokens": {
    "package": "@qeetrix/tokens",
    "version": "0.0.13",
    "files": {
      "package/dist/dtcg/": "Upstream/qeetrix-tokens/dtcg/",
      "package/dist/tokens.css": "Upstream/qeetrix-tokens/tokens.css",
      "package/LICENSE": "Upstream/qeetrix-tokens/LICENSE"
    }
  },
  "fonts": {
    "$comment": "The TTFs @qeetrix/tokens ships for native platforms, taken as they are: the sync checks each against the sha256 and size in the package's fonts/native.json, and that the full WOFF2 native.json says it was made from is the package's own (the web loads per-script subsets of it).",
    "manifest": "package/dist/fonts/native.json",
    "faces": [
      {
        "family": "sans",
        "webFamily": "Qeet Sans",
        "ttf": "QeetSans.ttf",
        "destination": "Sources/Qeetrix/Resources/Fonts/QeetSans.ttf",
        "licenseDestination": "Sources/Qeetrix/Resources/Fonts/QeetSans-OFL.txt"
      },
      {
        "family": "mono",
        "webFamily": "Fira Code",
        "ttf": "FiraCode-VF.ttf",
        "destination": "Sources/Qeetrix/Resources/Fonts/FiraCode-VF.ttf",
        "licenseDestination": "Sources/Qeetrix/Resources/Fonts/FiraCode-OFL.txt"
      }
    ]
  },
